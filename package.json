{
  "name": "cybertrace-checkin",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "next dev",
    "predev": "tsx scripts/copy-zxing-wasm.ts",
    "build": "next build",
    "prebuild": "tsx scripts/copy-zxing-wasm.ts",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "migrate": "tsx scripts/migrate.ts",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "loadtest": "tsx scripts/loadtest.ts",
    "stresstest": "tsx scripts/stresstest.ts"
  },
  "dependencies": {
    "@vercel/functions": "3.10.5",
    "bcryptjs": "^3.0.3",
    "exceljs": "4.4.0",
    "jose": "^6.2.17",
    "lucide-react": "^1.73.0",
    "next": "^15.5.29",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zxing-wasm": "3.1.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "postcss": "$postcss",
    "zod": "4.6.7",
    "uuid": "11.1.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
