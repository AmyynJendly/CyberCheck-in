# ---------------------------------------------------------------------------
# Cybertrace Check-in — environment variables
# Copy to .env.local for local development:  cp .env.example .env.local
# On Vercel: Project → Settings → Environment Variables (same names).
# NEVER commit real values.
# ---------------------------------------------------------------------------

# --- Supabase (section 3 of SPEC.md) ---------------------------------------
# Kept for reference / future use. The app talks to Postgres directly through
# DATABASE_URL (below), so these two are NOT read by the code today.
SUPABASE_URL=REPLACE_ME_SUPABASE_URL
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME_SUPABASE_SERVICE_ROLE_KEY

# Postgres connection string. All database access goes through this.
#  - local:      postgres://postgres:postgres@localhost:5432/cybertrace
#  - production: Supabase "Transaction pooler" string (port 6543), e.g.
#    postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=REPLACE_ME_SUPABASE_POOLER_CONNECTION_STRING
# TLS for non-local hosts: "no-verify" (default; encrypted, Supabase's pooler
# uses its own CA), "verify" (needs DATABASE_CA_CERT), or "disable".
DATABASE_SSL=no-verify
# Optional PEM of the Supabase CA (Database settings → SSL) when DATABASE_SSL=verify.
DATABASE_CA_CERT=
# Max connections per server instance. Keep small on Vercel.
PG_POOL_MAX=2

# --- Email (Gmail SMTP, smtp.gmail.com:465) --------------------------------
GMAIL_USER=cybertrace.issatso@gmail.com
GMAIL_APP_PASSWORD=REPLACE_ME_GMAIL_APP_PASSWORD
# "log" = do not send real email; print to console and save QR PNG + HTML
# to ./dev-emails/. Leave empty (or "smtp") in production.
DEV_EMAIL_MODE=
# "on" = send each QR email right after registration / walk-in / import (and on the
# Apps Script ping). Empty (default) = nothing is sent until an admin presses
# Admin → Emails → Send Waiting Now.
EMAIL_AUTO_SEND=

# --- App -------------------------------------------------------------------
# 32+ random bytes. Generate:  openssl rand -base64 48
SESSION_SECRET=REPLACE_ME_SESSION_SECRET_AT_LEAST_32_RANDOM_BYTES
# Key for PIN-only login (staff.pin_lookup). 32+ random characters, and the SAME
# value everywhere that shares the database (local .env.local and Vercel).
# Changing it means every staff PIN must be reset. Generate like SESSION_SECRET.
PIN_PEPPER=REPLACE_ME_PIN_PEPPER_AT_LEAST_32_RANDOM_CHARS
# Public URL of the deployed app, no trailing slash.
APP_BASE_URL=REPLACE_ME_APP_BASE_URL_e.g._https://cybertrace-checkin.vercel.app
